sequenceDiagram
    participant Client
    participant Controller as UserController
    participant Service as UserService
    participant Minio as MinioAdapter
    participant Repository as UserRepository
    Client->>Controller: PUT /user/avatar (avatar)
    Controller->>Service: update_user_avatar(user_id, avatar)
    Service->>Minio: upload_file_to_minio(avatar, "user-avatars")
    Minio-->>Service: avatar_url
    Service->>Repository: set_user_avatar(user_id, avatar_url)
    Repository-->>Service: updated_user
    Service-->>Controller: user_data_instance
    Controller-->>Client: user_data_instance
